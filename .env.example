# PROUD On-Chain — Environment Variable Template
#
# Copy this file to .env and fill in YOUR values before running any scripts.
#
#   cp .env.example .env
#
# ⚠️  NEVER commit your actual .env file — it is listed in .gitignore.
# ⚠️  NEVER put a real private key or secret key in this file.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# The Stellar network to target: "testnet" | "mainnet" | "local"
STELLAR_NETWORK=testnet

# Soroban-compatible RPC endpoint for the chosen network
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban-mainnet.stellar.org (community-run)
# Local:    http://localhost:8000/soroban/rpc
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase — must match STELLAR_NETWORK exactly
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Horizon REST API endpoint (used for account info, friendbot funding, etc.)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ---------------------------------------------------------------------------
# Admin / Deployer Identity
# ---------------------------------------------------------------------------

# Public key (G...) of the account that will deploy and administer contracts
# Obtain with: stellar keys address <key-alias>
ADMIN_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF

# Key alias registered with the Stellar CLI keystore (NOT the raw secret key)
# Create with: stellar keys generate deployer --network testnet
# The actual secret key is stored in ~/.config/stellar/identity/ — never here
DEPLOYER_KEY_ALIAS=deployer

# ---------------------------------------------------------------------------
# Deployed Contract IDs (populated after `stellar contract deploy`)
# ---------------------------------------------------------------------------

# Leave empty until each contract has been deployed; fill in the C... address
IDENTITY_REGISTRY_CONTRACT_ID=
REWARDS_CONTRACT_ID=
CAMPAIGN_VAULT_CONTRACT_ID=
ACHIEVEMENT_CERTIFICATE_CONTRACT_ID=
